{
  "name": "k53ninja",
  "version": "0.0.1",
  "private": true,
  "description": "K53 Study Guide",
  "scripts": {
    "analyze:build": "vite build --mode analyze",
    "analyze:run": "pnpm analyze:build",
    "build": "vite build",
    "lint": "pnpm lint:tsc && pnpm lint:scripts",
    "lint-fix": "biome check --write .",
    "lint:scripts": "biome check .",
    "lint:tsc": "pnpm tsc",
    "start": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tsc": "tsc",
    "cap-sync": "cap sync",
    "cap-copy": "cap copy",
    "cap-sync-android": "cap sync android",
    "cap-copy-android": "cap copy android",
    "cap-sync-ios": "cap sync ios",
    "cap-copy-ios": "cap copy ios",
    "svg-to-component": "pnpm exec svgr --icon"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
