# Copy this file to .dev.env and fill in the secret values.
# .dev.env is ignored by git.

FTP_HOST="ftp.k53studyguide.online"
FTP_USER="publisher@k53studyguide.online"
FTP_PASSWORD=""
VITE_GA_MEASUREMENT_ID=""
# Optional PostHog overrides for the lander. The phc_ project token is public
# and already defaulted in pkg/lander/index.html; only set these to point at a
# different project or a self-hosted / EU PostHog instance.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST=""
REVENUECAT_ANDROID_API_KEY=""
REVENUECAT_IOS_API_KEY=""

# Use "." when the FTP account lands directly in the website root.
# If needed, change this to "public_html".
FTP_REMOTE_DIR="."
