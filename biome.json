{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "files": {
    "includes": [
      "*.json",
      "*.jsonc",
      "*.md",
      "pkg/*/package.json",
      "pkg/app/*.json",
      "pkg/app/*.ts",
      "pkg/app/*.tsx",
      "pkg/app/*.mts",
      "pkg/app/*.html",
      "pkg/app/src/**/*.ts",
      "pkg/app/src/**/*.tsx",
      "pkg/app/src/**/*.js",
      "pkg/app/src/**/*.jsx",
      "pkg/app/src/**/*.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
