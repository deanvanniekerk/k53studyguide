{
  "name": "lander",
  "version": "0.0.0",
  "private": true,
  "description": "K53 Study Guide website and static English study topics",
  "scripts": {
    "start": "pnpm generate:topics && vite --host 0.0.0.0",
    "dev": "pnpm start",
    "preview": "vite preview --host 0.0.0.0",
    "build": "pnpm generate:topics && vite build",
    "test": "pnpm build && vitest run && node scripts/check-links.ts",
    "tsc": "tsc",
    "generate:topics": "node scripts/generate-topics.ts"
  },
  "dependencies": {
    "@k53studyguide/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
