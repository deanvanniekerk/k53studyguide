    "tsc": "tsc",
    "generate:topics": "node scripts/generate-topics.ts"
  },
  "dependencies": {
    "@ionic/react": "9.0.6",
    "@k53studyguide/shared": "workspace:*",
    "ionicons": "8.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
