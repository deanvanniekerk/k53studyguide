{
  "name": "lander",
  "version": "0.0.0",
  "private": true,
  "description": "K53 Study Guide website and interactive quiz demo",
  "scripts": {
    "start": "pnpm generate:topics && vite --host 0.0.0.0",
    "dev": "pnpm start",
